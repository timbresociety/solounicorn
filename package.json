{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "contract:check": "node scripts/check-repo-contract.mjs",
    "balance:validate": "node scripts/validate-balance.mjs",
    "balance:lock-check": "node scripts/validate-balance.mjs --require-locked",
    "sim:smoke": "node scripts/simulation-smoke.mjs",
    "sim:determinism": "node scripts/check-determinism.mjs",
    "validate": "npm run contract:check && npm run balance:validate && npm run sim:smoke && npm run sim:determinism && npm run test:founder && npm run typecheck && npm run lint",
    "ci": "npm run validate && npm run build",
    "test:unit": "vitest run tests/unit",
    "test:replay": "vitest run tests/replay",
    "test:integration": "vitest run tests/integration",
    "validate:content": "vitest run tests/unit/content-validation.test.ts",
    "test": "vitest run",
    "test:founder": "vitest run tests/integration/founder-content.test.ts tests/integration/founder-finance.test.ts tests/integration/founder-automation.test.ts tests/integration/founder-state-save.test.ts tests/integration/founder-company.test.ts tests/integration/founder-policy.test.ts tests/integration/founder-toys.test.ts tests/integration/founder-presentation.test.ts tests/integration/founder-resilience.test.ts tests/integration/founder-checkpoint-db.test.ts",
    "postbuild": "node scripts/prepare-founder-offline.mjs",
    "balance:founder-matrix": "RUN_FOUNDER_MATRIX=1 vitest run tests/simulation/founder-matrix.test.ts",
    "pwa:check": "node scripts/check-founder-offline.mjs",
    "test:founder-earned": "vitest run tests/simulation/founder-earned-run.test.ts"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.63.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^3.2.4",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
