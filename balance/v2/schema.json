{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solounicorn.local/balance/v2/registry.schema.json",
  "title": "ONE PERSON UNICORN V2 Balance Registry",
  "type": "object",
  "required": ["balanceVersion", "status", "runtimeReady", "sourceOfTruth", "parameters"],
  "properties": {
    "balanceVersion": {"type": "string", "minLength": 1},
    "status": {"enum": ["calibration", "candidate", "locked"]},
    "runtimeReady": {"type": "boolean"},
    "sourceOfTruth": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["status", "requiredForRuntime", "value", "unit", "source"],
        "properties": {
          "status": {"enum": ["missing", "calibration", "provisional", "candidate", "locked"]},
          "requiredForRuntime": {"type": "boolean"},
          "value": {},
          "unit": {"type": "string"},
          "source": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
